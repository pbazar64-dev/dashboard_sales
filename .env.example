# Пример переменных окружения. Реальные значения НЕ коммитить.
#
# Ключ авторизации OAuth-приложения Вайбкод (vibe_app_…).
# На платформе задаётся как секрет в карточке приложения, а не в коде.
VIBE_APP_KEY=
#
# Порт задаёт платформа (переменная PORT), локально по умолчанию 3000.
# PORT=3000
#
# DEMO_MODE=1 — показать интерфейс на демо-данных без портала и ключей.
# DEMO_MODE=1
